{
  "id": "dataforseo-serp",
  "type": "source",
  "name": "DataForSEO SERP API",
  "version": "1.0.0",
  "entry": "entry.py",
  "permissions": ["network", "credentials:dataforseo"],
  "config": {
    "login": {
      "desc": "DataForSEO login email",
      "required": true,
      "secret": false
    },
    "password": {
      "desc": "API password",
      "required": true,
      "secret": true
    }
  },
  "provides": {
    "metrics": ["serp_organic", "serp_features", "ai_overview"],
    "engines": ["google", "bing", "youtube"],
    "latency": "standard|priority|live",
    "cost_hint": "0.0006 USD/SERP standard"
  }
}
