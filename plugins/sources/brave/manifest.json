{
  "id": "brave",
  "type": "source",
  "name": "Brave Search API",
  "version": "1.0.0",
  "entry": "entry.py",
  "permissions": ["network", "credentials:brave"],
  "config": {
    "api_key": {
      "desc": "Brave Search API key",
      "required": true,
      "secret": true
    }
  },
  "provides": {
    "metrics": ["serp_organic", "serp_news", "serp_videos"],
    "engines": ["brave"],
    "latency": "priority",
    "cost_hint": "Free tier: 2000 req/mo; $3/1000 queries"
  }
}
