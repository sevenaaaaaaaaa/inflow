# Insight Flow 配置示例
# 复制此文件为 .env 并填入实际值

# 必填：主密钥（用于加密凭据）
INSFLOW_MASTER_KEY=your-master-key-here

# 服务配置
INSFLOW_PORT=8400
INSFLOW_HOST=0.0.0.0

# OpenFlow 集成
OPENFLOW_BASE_URL=http://localhost:8088
OPENFLOW_API_KEY=

# MFlow 集成
MFLOW_BASE_URL=http://localhost:8088
MFLOW_CONSOLE_PASSWORD=

# MFlow 数据目录
LOVART_LOCAL_DEV_ROOT=/Users/seveno/MFlow Dev

# 搜索 API Keys（可选，按需配置）
SERPER_API_KEY=
BRAVE_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# 其他数据源 API Keys（可选）
GDELT_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
ZHIHU_API_KEY=

# LLM 配置（Agent 功能需要）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
