# Insight Flow 配置示例
# 复制此文件为 .env 并填入实际值

# 数据库驱动（sqlite | mysql）
# sqlite：内嵌零依赖（个人/自托管默认）
# mysql：生产/多租户推荐（对齐 OpenFlow 事件表选型）
INSFLOW_DB_DRIVER=sqlite
# MySQL 配置（INSFLOW_DB_DRIVER=mysql 时生效；命名对齐 OpenFlow mysql_* 约定）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DBNAME=insflow
MYSQL_USER=insflow
MYSQL_PASS=
MYSQL_POOL_SIZE=5
# 缓存后端：留空=进程内；file=文件缓存（跨进程/重启不丢）
INSFLOW_CACHE=

# 必填：主密钥（用于加密凭据）
INSFLOW_MASTER_KEY=your-master-key-here

# 服务配置
INSFLOW_PORT=8400
INSFLOW_HOST=0.0.0.0

# OpenFlow 集成
OPENFLOW_BASE_URL=http://localhost:8088
OPENFLOW_API_KEY=

# MFlow 集成
MFLOW_BASE_URL=http://localhost:8088
MFLOW_CONSOLE_PASSWORD=

# MFlow 数据目录
LOVART_LOCAL_DEV_ROOT=/Users/seveno/MFlow Dev

# 搜索 API Keys（可选，按需配置）
SERPER_API_KEY=
BRAVE_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# 其他数据源 API Keys（可选）
GDELT_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
ZHIHU_API_KEY=

# LLM 配置（Agent 功能需要）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
INSFLOW_AGENT_MODEL=gpt-4o-mini
# 模型路由：抽取/分类/摘要走 CHEAP，推理走 STRONG；不配则两层同一个模型（行为不变）
# INSFLOW_AGENT_MODEL_CHEAP=gpt-4o-mini
# INSFLOW_AGENT_MODEL_STRONG=gpt-4o
# 会话预算与降级水位（用到 70% 后强模型自动降为便宜模型，而不是直接断供）
# INSFLOW_AGENT_BUDGET_USD=5.0
# INSFLOW_AGENT_DEGRADE_AT=0.7
# 价格表覆盖（{"模型": [每百万 in, 每百万 out]}），用于预算与客户 ROI 口径
# INSFLOW_MODEL_PRICES={"deepseek-chat": [0.27, 1.10]}
# 语义检索：不配 = 本地 n-gram 向量（零依赖、零成本、同义改写召不回）
#           配了 = 走 embedding API（换模型后索引自动重算）
# INSFLOW_EMBED_MODEL=text-embedding-3-small
# Prompt 版本锁定（不配用 prompts/ 目录里最大版本）
# INSFLOW_PROMPT_AGENT_SYSTEM=1
# INSFLOW_PROMPTS_DIR=/opt/insflow/prompts

# ── 多实例（水平扩展）可选配置 ──
# 配了 Redis 才会启用：共享缓存 / leader 选举（定时任务只跑一份）/ SSE 跨实例广播
# 多实例必须用 MySQL（SQLite 单文件无法多进程写）
# INSFLOW_REDIS_URL=redis://127.0.0.1:6379/0
# INSFLOW_REDIS_URL=redis://:password@redis.internal:6379/0
