# MCP over HTTP（OpenFlow / Dify / 任意客户端）
# GET  $IF_BASE/api/v1/mcp/tools
# POST $IF_BASE/api/v1/mcp/tools/call
#   {"name":"list_insights","arguments":{"workspace_id":"insflow-demo","limit":5}}
#
# 默认 INSFLOW_MCP_AUTH=1，需要 X-API-Key（先 insflow auth key-add）。
IF_BASE=http://127.0.0.1:8400
IF_API_KEY=
IF_WORKSPACE=insflow-demo
